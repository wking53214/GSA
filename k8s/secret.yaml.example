# Template only. Do not commit a filled-in copy of this file.
#
# Create the real secret out of band:
#
#   kubectl create secret generic gsa-secrets \
#     --namespace=gsa \
#     --from-literal=hmac-key=$(openssl rand -hex 32) \
#     --from-file=jwt-public-key=/path/to/jwt_public.pem
#
# GSA_ENV=prod refuses unsigned tokens, so jwt-public-key is REQUIRED in
# production. auth.py falls back to an insecure development key when the HMAC
# secret is absent and logs a warning; that path must never run in prod.
apiVersion: v1
kind: Secret
metadata:
  name: gsa-secrets
  namespace: gsa
type: Opaque
stringData:
  # Attestation HMAC key. Generate with `openssl rand -hex 32`.
  # Use a distinct value per environment.
  hmac-key: ""
  # RS256 public key (PEM) used to verify tenant JWTs.
  jwt-public-key: ""
