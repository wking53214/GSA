    {
      "id": 11,
      "title": "Adaptive control (FDR loop)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Risk threshold vs observed FDR",
      "type": "timeseries",
      "description": "The FDR controller raises the block threshold when too many blocks come back labelled false alarms. Alert GSAFDRDrift fires above 0.10 for 10m. A flat threshold with FDR pinned at 1.0 means the active policy scores near zero on everything -- that is a policy problem, not a controller problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "gsa_risk_threshold",
          "legendFormat": "risk threshold",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "gsa_observed_fdr",
          "legendFormat": "observed FDR",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "vector(0.05)",
          "legendFormat": "FDR target",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "max": 1.0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Correction attempts per request",
      "type": "timeseries",
      "description": "Output-correction loop pressure. Rising p95 means the policy keeps rejecting generations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gsa_correction_attempts_bucket[5m])))",
