# GSA gateway configuration (12-factor). Copy to .env and adjust.
GSA_ENV=dev                         # dev | staging | prod  (prod refuses unsigned tokens)
GSA_LOG_LEVEL=INFO

# Request limits
GSA_MAX_REQUEST_CHARS=8000

# Risk threshold / FDR adaptive control
GSA_RISK_BLOCK_THRESHOLD=0.80
GSA_FDR_TARGET=0.05

# Correction loop / attestation pool
GSA_MAX_CORRECTION_ATTEMPTS=4
GSA_ATTESTATION_WORKERS=4
GSA_ATTESTATION_QUEUE_SIZE=256

# Circuit breaker
GSA_CB_FAILURE_THRESHOLD=5
GSA_CB_RECOVERY_TIMEOUT_S=5.0

# Per-tenant rate limiting
GSA_RATE_LIMIT_CAPACITY=60
GSA_RATE_LIMIT_REFILL_PER_SEC=10.0

# Secrets / auth
GSA_SECRET_PROVIDER=env             # env | file
GSA_SECRET_KEY=                     # HMAC signing key (REQUIRED in prod; set via secret manager)
# GSA_SECRET_FILE=/run/secrets/gsa_hmac_key   # used when GSA_SECRET_PROVIDER=file
GSA_JWT_PUBLIC_KEY_PATH=            # PEM public key path; when set, bearer tokens verified as RS256 JWTs
GSA_JWT_ISSUER=
GSA_JWT_AUDIENCE=
GSA_JWT_TENANT_CLAIM=tenant_id

# Persistence
GSA_AUDIT_BACKEND=memory            # memory | sqlite
GSA_AUDIT_DB_PATH=/data/gsa_audit.db
